{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otimizador",
  "version": "0.1.0",
  "identifier": "br.otimizador.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Otimizador",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
