{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexTune",
  "version": "0.1.0",
  "identifier": "io.github.hampikamayuq.nextune",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NexTune",
        "width": 1240,
        "height": 800,
        "minWidth": 760,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hampikamayuq/NexTune/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQjk3NjQ5NDdEM0U2QzgKUldUSTV0TkhTWGE1RXNOamxJQmZMY29vVlRrMUFZcG5kNzlYU3hFNlMwOEM5Tk1pbkxOOXgwK0wK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": {
      "../scripts/*.ps1": "scripts/",
      "../data": "data/"
    },
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "NexTune",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "PortugueseBR"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
